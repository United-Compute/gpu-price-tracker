{
  "actorSpecification": 1,
  "name": "gpu-prices",
  "title": "GPU Cloud Prices & Availability: H100, B200, RTX 5090 + 70 more",
  "description": "Live rental prices and real availability for 70+ GPU models across 50+ clouds (RunPod, Lambda, Vast.ai, Nebius and more), checked every 15 minutes. H100, H200, B200, B300, A100, L40S, RTX 4090/5090, MI300X and more, by region, VRAM and price, plus the GPU Price Index. No API key.",
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "./Dockerfile",
  "readme": "../README.md",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "GPU offers",
      "views": {
        "overview": {
          "title": "Offers",
          "transformation": {
            "fields": [
              "gpu_name",
              "provider_name",
              "price_per_hour",
              "list_price_per_hour",
              "in_stock",
              "stock_level",
              "cloud_type",
              "pricing",
              "vram_gb",
              "regions",
              "checked_at"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "gpu_name": {
                "label": "GPU"
              },
              "provider_name": {
                "label": "Cloud"
              },
              "price_per_hour": {
                "label": "Price now ($/GPU-hr)",
                "format": "number"
              },
              "list_price_per_hour": {
                "label": "Advertised ($/GPU-hr)",
                "format": "number"
              },
              "in_stock": {
                "label": "Rentable now",
                "format": "boolean"
              },
              "stock_level": {
                "label": "Stock"
              },
              "cloud_type": {
                "label": "Type"
              },
              "pricing": {
                "label": "Pricing"
              },
              "vram_gb": {
                "label": "VRAM (GB)",
                "format": "number"
              },
              "regions": {
                "label": "Regions",
                "format": "array"
              },
              "checked_at": {
                "label": "Checked",
                "format": "date"
              }
            }
          }
        }
      }
    }
  }
}
